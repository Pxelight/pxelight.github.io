* {
    background-color: #030919;
    text-color: #89b4fa;
    border-color: #236ee3;
}

window {
    location: south;
    margin: 0px 0px 10px 0px;
    width: 57%;
    height: 32%;
    border: 2px;
    border-radius: 12px;
    padding: 20px;
    background-color: #030919;
    children: [ inputbar, listview ];
    spacing: 15px;
}

inputbar {
    padding: 10px;
    children: [ prompt, entry ];
    spacing: 10px;
}

listview {
    columns: 4;
    lines: 3;
    flow: vertical;
    fixed-columns: true;
    spacing: 12px;
    scrollbar: false;
}

element {
    orientation: vertical;
    padding: -36px -64px -36px -64px; /* 8px */
    border-radius: 8px;
    background-color: #071634;
    spacing: 8px;
}

element selected {
    background-color: #1a4693;
    border: 2px;
    border-color: #89b4fa;
}

element-icon {
    size: 180px; /* 180px */
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    enabled: false;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

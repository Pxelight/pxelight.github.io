{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    //"source": "/home/$USER/.config/fastfetch/images/image.png",
    "width": 16, //48
    "color": {
      "1": "blue",
      "2": "blue",
    },
    "padding": {
      "top": 1,
      "left": 2
    }
  },

  "display": {
    "separator": " ➜ ",
    "color": "#89b4fa"
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#3691f4",
        "at": "#98e9fc",
        "host": "#3691f4"
      }
    },

    "break",

    {
      "type": "os",
      "key": "󰣇 OS      "
    },
    {
      "type": "kernel",
      "key": " Kernel  "
    },
    {
      "type": "packages",
      "key": "󰏗 Packages"
    },
    {
      "type": "shell",
      "key": " Shell   "
    },

    "break",

    {
      "type": "wm",
      "key": " WM      "
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "cpu",
      "key": " CPU     "
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU     "
    },

    "break",

    {
      "type": "memory",
      "key": " Memory  "
    },
    {
      "type": "disk",
      "key": " Disk    "
    },
    {
      "type": "uptime",
      "key": "󱑂 Uptime  "
    },

    "break",

    {
      "type": "colors"
    }
  ]
}
